{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "karet keymap",
  "description": "User (`$XDG_CONFIG_HOME/karet/keymap.jsonc`) or project (`$GIT_ROOT/.karet/keymap.jsonc`) key bindings, applied in order over the built-in keymap. The project file applies after the user file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "bindings": {
      "description": "Bindings and unbindings, applied in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },

    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "key": {
          "description": "One chord (`ctrl+shift+p`) or a space-separated sequence (`ctrl+k ctrl+w`). Modifiers: ctrl, shift, alt. Required to bind; optional to unbind.",
          "type": "string"
        },
        "command": {
          "description": "The command id to bind, or `-` + an id to remove that command's bindings (narrowed by `key` and `when` when given).",
